# NanoClaw V2 — environment variable reference
# Copy relevant lines to .env and fill in values.
# This file is gitignored — keep .env gitignored too.

# ── Timezone ──
TZ=Europe/Zurich

# ── Telegram ──
# Main bot token (required for Telegram channel)
TELEGRAM_CLAUDE_BOT_TOKEN=

# Bot pool: comma-separated tokens for agent-swarm multi-identity sends
# Pool bots are send-only; they do not poll inbound messages.
TELEGRAM_BOT_POOL=

# Dedicated Codex test bot token. When set, NanoClaw starts a second
# polling Telegram adapter with channel_type=telegram_codex.
TELEGRAM_CODEX_BOT_TOKEN=

# ── Anthropic auth ──
# Use oauth (OneCLI manages the credential) or api-key
ANTHROPIC_AUTH_MODE=oauth
# ANTHROPIC_API_KEY=  # only needed if ANTHROPIC_AUTH_MODE=api-key

# ── OneCLI ──
ONECLI_URL=http://172.17.0.1:10254
CLAUDE_ONECLI_SECRET_ID=

# ── Container secrets ──
# Variables prefixed CONTAINER_SECRET_ are forwarded into agent containers as-is.
# Use for secrets that OneCLI cannot inject (e.g. non-HTTP URLs, webhook tokens).
# CONTAINER_SECRET_PROTON_ICAL_URL=https://calendar.proton.me/api/calendar/v1/...

# ── Container resource caps ──
# Optional per-agent-container Docker limits. Empty/unset means unbounded.
# MAX_CONCURRENT_CONTAINERS=5
# CONTAINER_CPU_LIMIT=2
# CONTAINER_MEMORY_LIMIT=8g

# ── Egress lockdown ──
# Optional network-layer lock: agent containers can only reach the OneCLI gateway.
# Direct internet access from non-proxy-aware tools will fail by design.
# NANOCLAW_EGRESS_LOCKDOWN=true
# NANOCLAW_EGRESS_NETWORK=nanoclaw-egress
# ONECLI_GATEWAY_CONTAINER=onecli

# ── Ollama ──
# Hostname/IP of the Ollama service reachable from within containers
# OLLAMA_HOST=

# Opt-in to management tools (pull/delete/show/list models).
# Set to true only if you trust your agents with model management operations.
# OLLAMA_ADMIN_TOOLS=true

# ── Stock screen guided mode ──
# Opt in to host-owned deterministic /screen-market guided wizard.
# When false/unset, exact /screen-market keeps the existing agent-guided path.
# SCREEN_MARKET_GUIDED_HOST=true
