{
  "name": "nanoclaw",
  "version": "2.0.71",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "vite@>=8.0.0 <=8.0.15": "8.0.16"
    }
  },
  "main": "dist/index.js",
  "bin": {
    "ncl": "bin/ncl"
  },
  "scripts": {
    "deps:install": "bash scripts/install-deps.sh",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "ncl": "tsx src/cli/client.ts",
    "chat": "tsx scripts/chat.ts",
    "setup:bootstrap": "bash setup.sh",
    "setup:step": "bash scripts/setup-step.sh",
    "auth": "tsx src/whatsapp-auth.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:watch": "vitest",
    "container:build": "bash scripts/build-agent-image.sh",
    "service:restart": "bash scripts/service-restart.sh",
    "service:status": "bash scripts/service-status.sh",
    "backup": "bash scripts/backup.sh",
    "smoke:rtk-shell": "bash scripts/rtk-shell-smoke.sh",
    "audit:model-neutral": "tsx scripts/model-neutral-audit.ts"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.38.1",
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "@onecli-sh/sdk": "2.2.1",
    "better-sqlite3": "11.10.0",
    "chat": "4.38.1",
    "cron-parser": "5.10.0",
    "grammy": "^1.46.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
