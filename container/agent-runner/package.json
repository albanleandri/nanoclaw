{
  "name": "nanoclaw-agent-runner",
  "version": "1.0.0",
  "type": "module",
  "description": "Container-side agent runner for NanoClaw",
  "overrides": {
    "@hono/node-server": "1.19.17",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.11",
    "ip-address": "10.7.2",
    "qs": "6.16.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage && bun run scripts/check-coverage.ts"
  },
  "dependencies": {
