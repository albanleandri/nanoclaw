    "@anthropic-ai/sdk": "^0.108.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opencode-ai/sdk": "1.4.17",
    "cron-parser": "^5.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
